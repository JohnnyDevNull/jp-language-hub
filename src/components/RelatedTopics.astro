---
import { uiLabel } from '~/lib/ui-labels';

interface RelatedTopic {
	href: string;
	label: string;
	description?: string;
}

interface Props {
	topics?: RelatedTopic[];
	title?: string;
}

const { topics = [], title } = Astro.props;
const { locale } = Astro.locals.starlightRoute;
const label = title ?? uiLabel('Related topics', locale);
---

{
	topics.length > 0 && (
		<nav class="related-topics" aria-label={label}>
			<p class="related-topics-title" aria-hidden="true">{label}</p>
			<ul class="related-topics-items">
				{topics.map((topic) => (
					<li class="related-topics-item">
						<a class="related-topics-link" href={topic.href}>
							<span class="related-topics-label">{topic.label}</span>
							{topic.description && (
								<span class="related-topics-description">{topic.description}</span>
							)}
						</a>
					</li>
				))}
			</ul>
		</nav>
	)
}
