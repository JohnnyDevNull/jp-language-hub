---
interface Props {
	title?: string;
}

const { title } = Astro.props;
---

<figure class="language-comparison">
	{title && <figcaption class="language-comparison-title">{title}</figcaption>}
	<div class="language-comparison-columns">
		<section class="language-comparison-language language-comparison-language-de" lang="de">
			<p class="language-comparison-language-name">
				<span aria-hidden="true">🇩🇪</span>
				Deutsch
			</p>
			<div class="language-comparison-content"><slot name="de" /></div>
		</section>
		<section class="language-comparison-language language-comparison-language-en" lang="en">
			<p class="language-comparison-language-name">
				<span aria-hidden="true">🇬🇧</span>
				English
			</p>
			<div class="language-comparison-content"><slot name="en" /></div>
		</section>
		<section class="language-comparison-language language-comparison-language-sv" lang="sv">
			<p class="language-comparison-language-name">
				<span aria-hidden="true">🇸🇪</span>
				Svenska
			</p>
			<div class="language-comparison-content"><slot name="sv" /></div>
		</section>
	</div>
</figure>
