---
interface Props {
	title?: string;
	language?: 'German' | 'English' | 'Swedish';
}

const { language, title = language ? `${language}-specific rule` : 'Language-specific rule' } = Astro.props;
---

<aside class="special-rule" aria-label={title}>
	<p class="special-rule-title" aria-hidden="true">{title}</p>
	<div class="special-rule-content"><slot /></div>
</aside>
