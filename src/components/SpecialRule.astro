---
import { uiLabel } from '~/lib/ui-labels';

interface Props {
	title?: string;
	language?: 'German' | 'English' | 'Swedish';
}

const { language, title } = Astro.props;
const { locale } = Astro.locals.starlightRoute;
const label = title ?? (language ? `${language}-specific rule` : uiLabel('Language-specific rule', locale));
---

<aside class="special-rule" aria-label={label}>
	<p class="special-rule-title" aria-hidden="true">{label}</p>
	<div class="special-rule-content"><slot /></div>
</aside>
