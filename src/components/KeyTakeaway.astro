---
import { uiLabel } from '~/lib/ui-labels';

interface Props {
	title?: string;
}

const { title } = Astro.props;
const { locale } = Astro.locals.starlightRoute;
const label = title ?? uiLabel('In short', locale);
---

<aside class="key-takeaway" aria-label={label}>
	<p class="key-takeaway-title" aria-hidden="true">{label}</p>
	<div class="key-takeaway-content"><slot /></div>
</aside>
