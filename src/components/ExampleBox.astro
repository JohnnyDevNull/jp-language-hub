---
import { uiLabel } from '~/lib/ui-labels';

interface Props {
	title?: string;
	lang?: 'de' | 'en' | 'sv';
}

const { title, lang } = Astro.props;
const { locale } = Astro.locals.starlightRoute;
const label = title ?? uiLabel('Example', locale);
---

<aside class="example-box" aria-label={label}>
	<p class="example-box-title" aria-hidden="true">{label}</p>
	<div class="example-box-content" lang={lang}><slot /></div>
</aside>
