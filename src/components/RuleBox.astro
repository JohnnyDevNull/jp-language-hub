---
import { uiLabel } from '~/lib/ui-labels';

interface Props {
	title?: string;
}

const { title } = Astro.props;
const { locale } = Astro.locals.starlightRoute;
const label = title ?? uiLabel('Rule', locale);
---

<aside class="rule-box" aria-label={label}>
	<p class="rule-box-title" aria-hidden="true">{label}</p>
	<div class="rule-box-content"><slot /></div>
</aside>
