---
import { importantIndexPath, levelIndexPath } from '~/lib/content-index-paths';
import { getLearnLanguageFromPathname } from '~/lib/learn-languages';
import { uiLabel } from '~/lib/ui-labels';

interface Props {
	levels?: string[];
	tags?: string[];
	label?: string;
}

const { levels = [], tags = [], label } = Astro.props;

const { locale } = Astro.locals.starlightRoute;
const listLabel = label ?? uiLabel('Level and tags', locale);
const learnLanguage = getLearnLanguageFromPathname(Astro.url.pathname);
const levelHref = levelIndexPath(locale, learnLanguage);
const importantHref = importantIndexPath(locale, learnLanguage);

/* A pill becomes a link only where an index page can answer it. The remaining
   tags classify the page for search and future indexes; presenting them as
   links would promise navigation that does not exist. */
const items = [
	...levels.map((level) => ({ label: level, href: levelHref })),
	...tags.map((tag) => ({
		label: tag,
		href: tag === 'important' ? importantHref : undefined,
	})),
];
---

{
	items.length > 0 && (
		<aside class="tag-list" aria-label={listLabel}>
			<p class="tag-list-label" aria-hidden="true">{listLabel}</p>
			<ul class="tag-list-items">
				{items.map((item) => (
					<li class="tag-list-item">
						{item.href ? (
							<a class="tag-list-link" href={item.href}>
								{item.label}
							</a>
						) : (
							item.label
						)}
					</li>
				))}
			</ul>
		</aside>
	)
}
