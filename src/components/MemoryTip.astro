---
import { uiLabel } from '~/lib/ui-labels';

interface Props {
	title?: string;
}

const { title } = Astro.props;
const { locale } = Astro.locals.starlightRoute;
const label = title ?? uiLabel('Memory tip', locale);
---

<aside class="memory-tip" aria-label={label}>
	<p class="memory-tip-title" aria-hidden="true">{label}</p>
	<div class="memory-tip-content"><slot /></div>
</aside>
