{
  "name": "jp-language-hub",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "npm run lint:eslint && npm run lint:css",
    "lint:eslint": "eslint \"src/**/*.{astro,js,mjs,ts}\" \"*.mjs\" --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" --allow-empty-input --max-warnings 0",
    "check": "astro check",
    "quality": "npm run lint && npm run check"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.10",
    "astro": "^7.1.6",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "~3.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
